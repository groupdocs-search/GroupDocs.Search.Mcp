<Project>

  <PropertyGroup Label="SDK Versions">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible build">
    <Deterministic>true</Deterministic>
    <!-- Normalizes paths inside .pdb/.dll on CI for reproducible output -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package information">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/groupdocs-search/GroupDocs.Search.Mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/groupdocs-search/GroupDocs.Search.Mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>GroupDocs Contributors</Authors>
    <Company>Aspose</Company>
    <Copyright>Copyright © Aspose Pty Ltd $([System.DateTime]::Now.Year)</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>true</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <GroupDocsSearchMcp>26.10.0</GroupDocsSearchMcp>
  </PropertyGroup>

  <PropertyGroup Label="External Dependency Versions">
    <GroupDocsMcpCore>26.9.0</GroupDocsMcpCore>
    <!-- Single netstandard2.1 package (no TFM split, unlike Parser/Metadata). It declares
         SkiaSharp 3.119.1 + SkiaSharp.NativeAssets.Linux.NoDependencies, System.Drawing.Common
         6.0.0 and Microsoft.ML.OnnxRuntime 1.22.1 (image search) transitively. 26.10 redesigned
         the index format: indexes from 22.7-26.8 are converted when opened.
         See docs/backlog-and-issues.md. -->
    <GroupDocsSearch>26.10.0</GroupDocsSearch>
    <MicrosoftExtensionsHosting>10.0.5</MicrosoftExtensionsHosting>
    <ModelContextProtocol>1.1.0</ModelContextProtocol>
    <MicrosoftSourceLinkGithub>8.0.0</MicrosoftSourceLinkGithub>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Common Settings">
    <PackageReleaseNotes>https://github.com/groupdocs-search/GroupDocs.Search.Mcp/releases/tag/$(GroupDocsSearchMcp)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
